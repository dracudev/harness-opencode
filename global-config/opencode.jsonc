{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "openagent",
  "providers": {
    "opencode-go": {
      "settings": {
        "headerTimeout": false,
        "chunkTimeout": false
      }
    }
  },
  "mcp": {
    "engram": {
      "type": "local",
      "command": ["/home/dracudev/.local/bin/engram", "mcp", "--tools=agent"],
      "enabled": true,
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": false,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless", "--ignore-https-errors", "--executable-path", "/home/dracudev/.cache/ms-playwright/chromium-1234/chrome-linux64/chrome"],
      "enabled": false,
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx", "-y", "chrome-devtools-mcp@latest",
        "--isolated",
        "--no-performance-crux",
        "--no-usage-statistics",
      ],
      "enabled": false,
    },
  },
  "instructions": ["AGENTS.md"],
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#v7.0.0",
    "@tarquinen/opencode-dcp@latest",
    "@dietrichgebert/ponytail",
  ],
}
