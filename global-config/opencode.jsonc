{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "engram": {
      "command": ["/home/dracudev/.local/bin/engram", "mcp", "--tools=agent"],
      "enabled": true,
      "type": "local",
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": false,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless", "--ignore-https-errors", "--executable-path", "/home/dracudev/.cache/ms-playwright/chromium-1234/chrome-linux64/chrome"],
      "enabled": false,
    },
  },
  "instructions": ["AGENTS.md"],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@tarquinen/opencode-dcp@latest",
    "./ponytail/.opencode/plugins/ponytail.mjs",
  ],
}
